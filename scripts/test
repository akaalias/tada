#!/usr/bin/env bash
set -euo pipefail

# Run the full test suite via xcodebuild.
# The project is configured with XcodeGen (project.yml) and committed to git.
# Schemes are auto-generated by XcodeGen from project.yml - no manual scheme management needed.
#
# Usage: ./scripts/test

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

cd "$PROJECT_ROOT"

echo "🧪 Running unit tests..."
xcodebuild test \
  -project Tada.xcodeproj \
  -scheme TadaTests \
  -destination 'platform=macOS' || exit 1

echo ""
echo "🧪 Running integration tests..."
xcodebuild test \
  -project Tada.xcodeproj \
  -scheme TadaIntegrationTests \
  -destination 'platform=macOS' || exit 1

echo ""
echo "✅ All tests passed!"
